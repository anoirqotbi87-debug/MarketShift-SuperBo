# ────────────────────────────────────────────────────────────────────────────
# MarketShift Dashboard — Variables d'environnement
# Copier ce fichier vers .env.local pour le développement local.
# ────────────────────────────────────────────────────────────────────────────

# URL de base de l'API FastAPI (backend MarketShift-SuperBot).
# En local : http://localhost:8000
# En production : tunnel Cloudflare/ngrok ou URL du VPS (https://...)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL du WebSocket temps réel (dérivée de l'API).
# En local : ws://localhost:8000/ws
# En production : wss://.../ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Clé d'authentification API (doit correspondre à API_SECRET_KEY côté backend).
NEXT_PUBLIC_API_KEY=marketshift_dev_secret_key_2026