FROM ubuntu:22.04

# Désactiver les prompts interactifs pendant l'installation
ENV DEBIAN_FRONTEND=noninteractive

# Ajouter l'architecture i386 pour Wine et installer les dépendances
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y \
    software-properties-common \
    wget \
    gnupg2 \
    xvfb \
    x11vnc \
    fluxbox \
    python3.11 \
    python3.11-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Installation de WineHQ
RUN mkdir -pm755 /etc/apt/keyrings && \
    wget -O /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key && \
    wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources && \
    apt-get update && \
    apt-get install -y --install-recommends winehq-stable && \
    rm -rf /var/lib/apt/lists/*

# Définir l'environnement Wine
ENV WINEPREFIX=/root/.wine
ENV WINEARCH=win64
ENV WINEDEBUG=-all
ENV DISPLAY=:99

# Initialiser Wine (crée le préfixe sans popup graphique)
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 2 && \
    wineboot --init && \
    sleep 5 && \
    killall Xvfb

# Installer les dépendances Python
WORKDIR /app
COPY requirements.txt .
# S'assurer d'utiliser Python 3.11
RUN python3.11 -m pip install --no-cache-dir -r requirements.txt

# Copier le code source
COPY . /app

# Créer un script d'entrée (entrypoint) pour démarrer Xvfb puis Uvicorn
RUN echo '#!/bin/bash\n\
Xvfb :99 -screen 0 1024x768x16 &\n\
sleep 2\n\
fluxbox &\n\
sleep 1\n\
# Lancement de l'API FastAPI avec Python\n\
exec python3.11 main.py\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 8000

CMD ["/app/entrypoint.sh"]
