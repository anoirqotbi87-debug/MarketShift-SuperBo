# Étape 1 : Build
FROM node:18-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm install

COPY . .
# S'assurer que le backend cible l'environnement de production sur le même serveur
# Vous pouvez surcharger VITE_API_URL au moment du build si nécessaire
RUN npm run build

# Étape 2 : Serveur Web
FROM nginx:alpine

# Copier les fichiers buildés depuis l'étape 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Ajouter une configuration Nginx personnalisée pour les PWA (React Router / Vite)
RUN echo 'server {\n\
    listen 80;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
