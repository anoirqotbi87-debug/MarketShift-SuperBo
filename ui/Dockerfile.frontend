# Étape 1 : Build de l'application React/Vite
FROM node:20-alpine as builder

WORKDIR /app

# Copier les fichiers de dépendances
COPY package.json package-lock.json* ./

# Installer les dépendances
RUN npm install

# Copier le reste du code source
COPY . .

# Construire l'application pour la production
RUN npm run build

# Étape 2 : Serveur Nginx léger pour héberger les fichiers statiques
FROM nginx:alpine

# Copier les fichiers buildés depuis l'étape 1 vers Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Ajouter une configuration basique pour React Router (SPA)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Exposer le port 80
EXPOSE 80

# Démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]
